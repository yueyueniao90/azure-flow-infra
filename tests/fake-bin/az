#!/usr/bin/env bash
# shellcheck disable=SC2015,SC2016  # `[ cond ] && pass || fail` is intended; single quotes hold literal $VARS
# Fake Azure CLI for the offline tests. It never talks to Azure: it logs every call to
# $FAKE_AZ_STATE/calls.log and answers from small state files (see tests/helpers.sh).
# Unknown commands fail loudly (exit 99) so a script cannot silently do something untested.
set -u
: "${FAKE_AZ_STATE:?FAKE_AZ_STATE must point at a test state directory}"
S="$FAKE_AZ_STATE"
printf '%s\n' "$*" >>"$S/calls.log"

opt() { # opt <flag> <args...>: value following the flag
  local f="$1"
  shift
  while [ $# -gt 0 ]; do
    if [ "$1" = "$f" ]; then
      printf '%s' "${2:-}"
      return 0
    fi
    shift
  done
}
has() { # has <flag> <args...>
  local f="$1"
  shift
  for a in "$@"; do [ "$a" = "$f" ] && return 0; done
  return 1
}
fail() {
  printf 'fake az: %s\n' "$*" >&2
  exit "${2:-1}"
}

# The real Azure API error text for a malformed --condition, verbatim, so scripts under test see the
# same string a real `az role assignment create` would print.
fail_invalid_condition() {
  printf '(InvalidCreateOrUpdateRoleAssignmentRequest) The given role assignment condition is invalid.\nCode: InvalidCreateOrUpdateRoleAssignmentRequest\nMessage: The given role assignment condition is invalid. (fake az: %s)\n' "$1" >&2
  exit 1
}

# validate_condition <condition string>: a deliberately minimal sanity check on the Azure ABAC
# condition grammar built by bootstrap/seed.sh's rbac_condition() -- NOT a full ABAC parser. It exists
# only to catch the mistake this project actually shipped (an unquoted ActionMatches{...} action name)
# and the two other shapes in that same string a copy-paste of it could break: unbalanced parentheses
# and a malformed GuidEquals {...} list. It does not validate attribute names, operators, string
# literals elsewhere in the condition, or that the referenced roles/actions exist -- real Azure is the
# source of truth for that. Extend it only when a new real-world condition-string mistake needs catching.
validate_condition() {
  local c="$1" opens closes lists list body
  # Every ActionMatches{...} must hold a single-quoted string literal: ActionMatches{'a/b/c'}.
  printf '%s' "$c" | grep -Eq "ActionMatches\{[^']" &&
    fail_invalid_condition "ActionMatches{...} action name must be a single-quoted string literal"
  opens="$(printf '%s' "$c" | tr -cd '(' | wc -c | tr -d ' ')"
  closes="$(printf '%s' "$c" | tr -cd ')' | wc -c | tr -d ' ')"
  [ "$opens" = "$closes" ] || fail_invalid_condition "unbalanced parentheses ($opens open, $closes close)"
  lists="$(printf '%s' "$c" | grep -oE 'GuidEquals ?\{[^}]*\}')"
  if [ -n "$lists" ]; then
    while IFS= read -r list; do
      [ -n "$list" ] || continue
      body="${list#GuidEquals}"
      body="${body# }"
      body="${body#\{}"
      body="${body%\}}"
      printf '%s' "$body" | grep -Eq '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(, [0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})*$' ||
        fail_invalid_condition "malformed GuidEquals {...} list: '$body'"
    done <<EOF
$lists
EOF
  fi
}

cmd="${1:-} ${2:-}"
sub3="${3:-}"

case "$cmd" in
  "account show")
    [ ! -e "$S/not-logged-in" ] || fail "Please run 'az login'"
    q="$(opt --query "$@")"
    case "$q" in
      tenantId) echo "tenant-fake" ;;
      id) echo "sub-fake" ;;
      *) echo '{"id":"sub-fake","tenantId":"tenant-fake"}' ;;
    esac
    ;;
  "provider show")
    ns="$(opt --namespace "$@")"
    if [ -f "$S/provider.$ns" ]; then cat "$S/provider.$ns"; else echo NotRegistered; fi
    ;;
  "provider register")
    ns="$(opt --namespace "$@")"
    printf Registered >"$S/provider.$ns"
    ;;
  "vm list-usage")
    f="$S/usage.$(opt --location "$@").json"
    [ -f "$f" ] || fail "no usage fixture for region" 1
    cat "$f"
    ;;
  "vm list-skus")
    has --all "$@" || fail "list-skus without --all hides subscription-restricted sizes" 97
    f="$S/skus.$(opt --location "$@").json"
    [ -f "$f" ] || fail "no skus fixture for region" 1
    cat "$f"
    ;;
  "acr check-name")
    n="$(opt --name "$@")"
    if [ -e "$S/acr-taken.$n" ]; then echo '{"nameAvailable":false,"reason":"AlreadyExists"}'; else echo '{"nameAvailable":true}'; fi
    ;;
  "acr show")
    [ -e "$S/acr-own.$(opt --name "$@")" ] && echo '{}' || fail "not found" 3
    ;;
  "rest "*)
    [ ! -e "$S/rest-fails" ] || fail "rest not supported" 1
    n="$(printf '%s' "$(opt --body "$@")" | jq -r .name)"
    if [ -e "$S/swa-taken.$n" ]; then echo '{"nameAvailable":false,"reason":"AlreadyExists"}'; else echo '{"nameAvailable":true}'; fi
    ;;
  "staticwebapp show")
    [ -e "$S/swa-own.$(opt --name "$@")" ] && echo '{}' || fail "not found" 3
    ;;
  "staticwebapp hostname")
    case "$sub3" in
      show)
        n="$(opt --name "$@")"
        h="$(opt --hostname "$@")"
        [ -e "$S/rg.$(opt --resource-group "$@")" ] || fail "ResourceGroupNotFound" 3
        f="$S/swa-token.$n.$h"
        [ -f "$f" ] && cat "$f" || true
        ;;
      *) fail "unsupported: $*" 99 ;;
    esac
    ;;
  "group exists")
    [ -e "$S/rg.$(opt --name "$@")" ] && echo true || echo false
    ;;
  "group create")
    : >"$S/rg.$(opt --name "$@")"
    ;;
  "ad app")
    case "$sub3" in
      list)
        n="$(opt --filter "$@" | sed "s/.*displayName eq '\\(.*\\)'.*/\\1/")"
        [ -f "$S/app.$n" ] && cat "$S/app.$n"
        ;;
      create)
        n="$(opt --display-name "$@")"
        printf 'app-%s' "$n" >"$S/app.$n" # the service principal is created separately
        printf 'app-%s\n' "$n"
        ;;
      federated-credential)
        action="${4:-}"
        id="$(opt --id "$@")"
        case "$action" in
          list)
            n="$(opt --query "$@" | sed "s/.*name=='\\([^']*\\)'.*/\\1/")"
            [ -f "$S/fedcred.$id.$n" ] && cat "$S/fedcred.$id.$n"
            ;;
          create | update)
            p="$(opt --parameters "$@")"
            n="$(printf '%s' "$p" | jq -r .name)"
            printf '%s\n' "$p" | jq -r .subject >"$S/fedcred.$id.$n"
            printf '%s\n' "$p" | jq -e '.audiences == ["api://AzureADTokenExchange"] and .issuer == "https://token.actions.githubusercontent.com"' >/dev/null ||
              fail "unexpected federated credential parameters: $p" 98
            ;;
          *) fail "unsupported: $*" 99 ;;
        esac
        ;;
      *) fail "unsupported: $*" 99 ;;
    esac
    ;;
  "ad sp")
    case "$sub3" in
      list)
        a="$(opt --filter "$@" | sed "s/.*appId eq '\\(.*\\)'.*/\\1/")"
        [ -f "$S/sp.$a" ] && cat "$S/sp.$a"
        ;;
      create)
        a="$(opt --id "$@")"
        printf 'obj-%s' "${a#app-}" >"$S/sp.$a"
        printf 'obj-%s\n' "${a#app-}"
        ;;
      *) fail "unsupported: $*" 99 ;;
    esac
    ;;
  "role assignment")
    case "$sub3" in
      list)
        touch "$S/roles.jsonl"
        jq -s --arg o "$(opt --assignee "$@")" --arg r "$(opt --role "$@")" --arg s "$(opt --scope "$@")" \
          '[.[] | select(.principalId == $o and .roleDefinitionName == $r and (.scope | ascii_downcase) == ($s | ascii_downcase))]' "$S/roles.jsonl"
        ;;
      create)
        # Simulates Entra replication lag: the first N creates fail.
        if [ -f "$S/role-create-fail-first" ]; then
          n="$(cat "$S/role-create-fail-first")"
          if [ "$n" -gt 0 ]; then
            echo $((n - 1)) >"$S/role-create-fail-first"
            fail "PrincipalNotFound: principal does not exist in the directory yet" 1
          fi
        fi
        [ "$(opt --assignee-principal-type "$@")" = "ServicePrincipal" ] || fail "role create must pass --assignee-principal-type ServicePrincipal" 96
        if has --condition "$@"; then
          [ "$(opt --condition-version "$@")" = "2.0" ] || fail "condition needs --condition-version 2.0" 95
          cond_val="$(opt --condition "$@")"
          # Test-only trigger: every attempt is rejected, regardless of the condition string, so
          # tests/test_seed.sh can assert retry() fails fast on a permanent Azure rejection without
          # depending on rbac_condition() actually being broken.
          [ ! -f "$S/role-create-always-invalid-condition" ] || fail_invalid_condition "forced by test fixture"
          validate_condition "$cond_val"
        fi
        n="$(wc -l <"$S/roles.jsonl" 2>/dev/null | tr -d ' ')"
        jq -cn --arg id "ra-$((${n:-0} + 1))-$RANDOM" --arg o "$(opt --assignee-object-id "$@")" --arg r "$(opt --role "$@")" \
          --arg s "$(opt --scope "$@")" --arg c "$(opt --condition "$@")" \
          '{id: $id, principalId: $o, roleDefinitionName: $r, scope: $s, condition: (if $c == "" then null else $c end)}' >>"$S/roles.jsonl"
        ;;
      delete)
        id="$(opt --ids "$@")"
        grep -v "\"id\":\"$id\"" "$S/roles.jsonl" >"$S/roles.tmp" || true
        mv "$S/roles.tmp" "$S/roles.jsonl"
        ;;
      *) fail "unsupported: $*" 99 ;;
    esac
    ;;
  "role definition")
    case "$sub3" in
      list)
        n="$(opt --name "$@")"
        [ -f "$S/roledef.$n" ] && jq -e --arg p "/subscriptions/$(opt --subscription "$@")/" 'any(.AssignableScopes[]; startswith($p))' "$S/roledef.$n" >/dev/null && printf '%s\n' "$n"
        ;;
      create | update)
        n="$(printf '%s' "$(opt --role-definition "$@")" | jq -r .Name)"
        [ "$sub3" = update ] || [ ! -f "$S/roledef.$n" ] || fail "RoleDefinitionWithSameNameExists: role name '$n' is not unique in the tenant" 1
        printf '%s' "$(opt --role-definition "$@")" >"$S/roledef.$n"
        ;;
      *) fail "unsupported: $*" 99 ;;
    esac
    ;;
  "group delete")
    has --yes "$@" || fail "group delete without --yes would prompt" 94
    [ -e "$S/rg.$(opt --name "$@")" ] || fail "ResourceGroupNotFound" 3
    rm -f "$S/rg.$(opt --name "$@")"
    ;;
  "deployment group")
    [ -f "$(opt --template-file "$@")" ] || fail "template file not found: $(opt --template-file "$@")" 92
    [ -f "$(opt --parameters "$@")" ] || fail "parameters file not found: $(opt --parameters "$@")" 92
    [ -e "$S/rg.$(opt --resource-group "$@")" ] || fail "ResourceGroupNotFound" 3
    [ ! -e "$S/deploy-fails" ] || fail "deployment failed" 1
    # What the parameter file would have read from the environment.
    printf 'sub=%s suffix=%s api=%s web=%s\n' "${AZFLOW_SUBSCRIPTION_ID:-}" "${AZFLOW_NAME_SUFFIX:-}" \
      "${AZFLOW_API_PRINCIPAL_ID:-}" "${AZFLOW_WEB_PRINCIPAL_ID:-}" >>"$S/deploy-env.log"
    case "$sub3" in
      what-if)
        printf '\033[33mNote: The result may contain false positives.\033[0m\n\033[32m+ Create\033[0m\nResource changes: 1 to create.\n'
        ;;
      create)
        echo '{"registryLoginServer":{"type":"String","value":"acrfake.azurecr.io"},"staticWebAppDefaultHostname":{"type":"String","value":"fake.azurestaticapps.net"},"dnsNameServers":{"type":"Array","value":["ns1-01.azure-dns.com.","ns2-01.azure-dns.net.","ns3-01.azure-dns.org.","ns4-01.azure-dns.info."]}}'
        ;;
      *) fail "unsupported: $*" 99 ;;
    esac
    ;;
  "network dns")
    case "$sub3" in
      record-set)
        action="${4:-} ${5:-}"
        case "$action" in
          "txt add-record")
            rg="$(opt --resource-group "$@")"
            zone="$(opt --zone-name "$@")"
            name="$(opt --record-set-name "$@")"
            val="$(opt --value "$@")"
            [ -e "$S/rg.$rg" ] || fail "ResourceGroupNotFound" 3
            f="$S/txt.$rg.$zone.$name"
            touch "$f"
            grep -qxF "$val" "$f" || printf '%s\n' "$val" >>"$f"
            ;;
          *) fail "unsupported: $*" 99 ;;
        esac
        ;;
      *) fail "unsupported: $*" 99 ;;
    esac
    ;;
  "aks list")
    [ -e "$S/rg.$(opt --resource-group "$@")" ] || fail "ResourceGroupNotFound" 3
    n="$(opt --query "$@" | sed "s/.*name=='\\([^']*\\)'.*/\\1/")"
    if [ -f "$S/aks.$n" ]; then cat "$S/aks.$n"; fi
    ;;
  "aks stop" | "aks start")
    n="$(opt --name "$@")"
    [ -f "$S/aks.$n" ] || fail "ResourceNotFound: $n" 3
    if [ "${2:-}" = stop ]; then echo Stopped >"$S/aks.$n"; else echo Running >"$S/aks.$n"; fi
    ;;
  *)
    fail "unsupported command: $*" 99
    ;;
esac
